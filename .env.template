# Local Business Lead Intelligence Engine - Phase 3B (not production-ready)
# Copy to .env, never commit credentials, and restart after config changes.

# Core
# Optional random signing secret (32+ bytes). Blank generates persistent .jwt_secret.
# Protect the project directory using your Windows account ACL.
JWT_SECRET=
# First admin: 12+ characters, at most 72 UTF-8 bytes. Never printed.
# Remove this bootstrap value after the first successful startup.
INITIAL_ADMIN_PASSWORD=
DB_PATH=leadpro.db
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Must stay true; disabling verification fails startup.
VERIFY_SSL=true

# Discovery - one provider is needed for a search, not for startup.
# Review provider terms, retention and attribution before use.
SERPER_API_KEY=
# Places API (New) is the benchmark provider; use a separate restricted key when possible.
GOOGLE_PLACES_API_VERSION=new
GOOGLE_PLACES_NEW_API_KEY=
# Legacy-only compatibility key
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# Audit - optional external PageSpeed measurement; unknown when unavailable.
PAGESPEED_API_KEY=
SCRAPE_THREADS=2

# Persistent engine always runs one job; browser concurrency is capped at two.
MAX_CONCURRENT_TASKS=1
DISCOVERY_MAX_PAGES_PER_PROVIDER=3

# Separate official CamoFox REST service. See docs/CAMOFOX_SETUP.md.
# Never use CAMOFOX_API_KEY here (that upstream key is for cookie imports).
BROWSER_PROVIDER=camofox
CAMOFOX_BASE_URL=http://127.0.0.1:9377
CAMOFOX_ACCESS_KEY=
CAMOFOX_REQUEST_TIMEOUT_SEC=35
CAMOFOX_MAX_BROWSER_CONCURRENCY=2
CAMOFOX_MAX_PAGES_PER_BUSINESS=3
CAMOFOX_PAGE_SETTLE_MS=1200
AUDIT_SCREENSHOTS_ENABLED=false

# Feature flags - retired routes are unmounted in V0.1.
# Enabling outreach/public audit explicitly fails startup.
OUTREACH_ENABLED=false
PUBLIC_AUDIT_ENABLED=false
# No outreach scheduler runs, even if set true. The persistent search worker is separate.
SCHEDULER_ENABLED=false

# Optional AI - not used or required by the active search pipeline.
OPENROUTER_API_KEY=

# Legacy SMTP/IMAP, Brevo, Twilio, WhatsApp, PhantomBuster, enrichment and
# campaign variables are deprecated and absent from the active template.
